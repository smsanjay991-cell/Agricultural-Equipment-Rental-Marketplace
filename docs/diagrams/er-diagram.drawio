<mxfile host="Electron" modified="2026-08-06T22:00:00.000Z" agent="Mozilla/5.0" version="21.6.8" type="device">
  <diagram id="agrirent-er-diagram" name="AgriRent Enterprise ER Diagram">
    <mxGraphModel dx="1420" dy="880" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title & Header Banner -->
        <mxCell id="title-bg" value="" style="rounded=1;fillColor=#EFF6FF;strokeColor=#BFDBFE;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1520" height="90" as="geometry" />
        </mxCell>
        <mxCell id="title-text" value="AGRIRENT - ENTERPRISE ENTITY RELATIONSHIP (ER) DIAGRAM" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=22;fontStyle=1;fontColor=#1E3A8A;" vertex="1" parent="1">
          <mxGeometry x="60" y="45" width="1480" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle-text" value="Agricultural Equipment Rental Marketplace Database Model | Relational Schema &amp; Crow's Foot Cardinality" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontStyle=0;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="60" y="80" width="1480" height="25" as="geometry" />
        </mxCell>

        <!-- Legend Box -->
        <mxCell id="legend-box" value="LEGEND &amp; NOTATION:  PK = Primary Key (Bold Navy) | FK = Foreign Key (Blue) | UQ = Unique Key | IDX = Indexed Field&#xa;Theme: Enterprise Blue (#1E40AF) | White Background | Crow's Foot Relationship Notation" style="rounded=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1;fontSize=11;fontColor=#334155;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="130" width="1520" height="40" as="geometry" />
        </mxCell>

        <!-- 1. USERS TABLE -->
        <mxCell id="tbl-users" value="USERS (User Accounts &amp; Profiles)&#xa;--------------------------------------------------&#xa;PK | id : INT (AUTO_INCREMENT)&#xa;UQ | email : VARCHAR(255)&#xa;    | name : VARCHAR(100)&#xa;    | password : VARCHAR(255) [bcrypt]&#xa;IDX| role : ENUM('farmer','owner','admin')&#xa;    | phone : VARCHAR(20)&#xa;    | address : TEXT&#xa;    | created_at : DATETIME" style="swipeable=0;fillColor=#FFFFFF;strokeColor=#1E40AF;strokeWidth=2;fontColor=#0F172A;align=left;spacingLeft=12;spacingRight=12;verticalAlign=top;fontStyle=0;fontSize=12;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="220" width="320" height="200" as="geometry" />
        </mxCell>

        <!-- 2. CATEGORIES TABLE -->
        <mxCell id="tbl-categories" value="CATEGORIES (Equipment Types)&#xa;--------------------------------------------------&#xa;PK | id : INT (AUTO_INCREMENT)&#xa;UQ | name : VARCHAR(100)&#xa;    | description : TEXT&#xa;    | image_url : VARCHAR(255)&#xa;    | created_at : DATETIME" style="swipeable=0;fillColor=#FFFFFF;strokeColor=#1E40AF;strokeWidth=2;fontColor=#0F172A;align=left;spacingLeft=12;spacingRight=12;verticalAlign=top;fontStyle=0;fontSize=12;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="460" y="220" width="280" height="150" as="geometry" />
        </mxCell>

        <!-- 3. EQUIPMENT TABLE -->
        <mxCell id="tbl-equipment" value="EQUIPMENT (Machinery Listings)&#xa;--------------------------------------------------&#xa;PK | id : INT (AUTO_INCREMENT)&#xa;FK | owner_id : INT -> users(id)&#xa;FK | category_id : INT -> categories(id)&#xa;    | title : VARCHAR(150)&#xa;    | description : TEXT&#xa;    | daily_rate : DECIMAL(10,2)&#xa;    | location : VARCHAR(255)&#xa;    | condition_status : ENUM(...)&#xa;IDX| is_available : BOOLEAN [TRUE]&#xa;    | image_url : VARCHAR(255)&#xa;    | created_at : DATETIME" style="swipeable=0;fillColor=#FFFFFF;strokeColor=#1E40AF;strokeWidth=2;fontColor=#0F172A;align=left;spacingLeft=12;spacingRight=12;verticalAlign=top;fontStyle=0;fontSize=12;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="800" y="220" width="340" height="240" as="geometry" />
        </mxCell>

        <!-- 4. BOOKINGS TABLE -->
        <mxCell id="tbl-bookings" value="BOOKINGS (Rental Reservations)&#xa;--------------------------------------------------&#xa;PK | id : INT (AUTO_INCREMENT)&#xa;FK | equipment_id : INT -> equipment(id)&#xa;FK | farmer_id : INT -> users(id)&#xa;    | start_date : DATE&#xa;    | end_date : DATE&#xa;    | total_days : INT&#xa;    | total_price : DECIMAL(10,2)&#xa;IDX| status : ENUM('pending',...)&#xa;    | created_at : DATETIME" style="swipeable=0;fillColor=#FFFFFF;strokeColor=#1E40AF;strokeWidth=2;fontColor=#0F172A;align=left;spacingLeft=12;spacingRight=12;verticalAlign=top;fontStyle=0;fontSize=12;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="1200" y="220" width="340" height="230" as="geometry" />
        </mxCell>

        <!-- 5. PAYMENTS TABLE -->
        <mxCell id="tbl-payments" value="PAYMENTS (Transactions &amp; Escrow)&#xa;--------------------------------------------------&#xa;PK | id : INT (AUTO_INCREMENT)&#xa;FK | booking_id : INT (UNIQUE) -> bookings(id)&#xa;UQ | transaction_id : VARCHAR(100)&#xa;    | amount : DECIMAL(10,2)&#xa;    | payment_method : ENUM(...)&#xa;IDX| payment_status : ENUM(...)&#xa;    | payment_date : DATETIME" style="swipeable=0;fillColor=#FFFFFF;strokeColor=#1E40AF;strokeWidth=2;fontColor=#0F172A;align=left;spacingLeft=12;spacingRight=12;verticalAlign=top;fontStyle=0;fontSize=12;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="1200" y="550" width="340" height="190" as="geometry" />
        </mxCell>

        <!-- 6. NOTIFICATIONS TABLE -->
        <mxCell id="tbl-notifications" value="NOTIFICATIONS (System Alerts)&#xa;--------------------------------------------------&#xa;PK | id : INT (AUTO_INCREMENT)&#xa;FK | user_id : INT -> users(id)&#xa;FK | booking_id : INT (NULL) -> bookings(id)&#xa;    | title : VARCHAR(150)&#xa;    | message : TEXT&#xa;    | type : ENUM('booking','payment',...)&#xa;IDX| is_read : BOOLEAN [FALSE]&#xa;    | created_at : DATETIME" style="swipeable=0;fillColor=#FFFFFF;strokeColor=#1E40AF;strokeWidth=2;fontColor=#0F172A;align=left;spacingLeft=12;spacingRight=12;verticalAlign=top;fontStyle=0;fontSize=12;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="550" width="320" height="200" as="geometry" />
        </mxCell>

        <!-- 7. REVIEWS TABLE -->
        <mxCell id="tbl-reviews" value="REVIEWS (Ratings &amp; Feedback)&#xa;--------------------------------------------------&#xa;PK | id : INT (AUTO_INCREMENT)&#xa;FK | equipment_id : INT -> equipment(id)&#xa;FK | farmer_id : INT -> users(id)&#xa;    | rating : INT (CHECK 1..5)&#xa;    | comment : TEXT&#xa;UQ | (farmer_id, equipment_id)&#xa;    | created_at : DATETIME" style="swipeable=0;fillColor=#FFFFFF;strokeColor=#1E40AF;strokeWidth=2;fontColor=#0F172A;align=left;spacingLeft=12;spacingRight=12;verticalAlign=top;fontStyle=0;fontSize=12;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="800" y="550" width="340" height="190" as="geometry" />
        </mxCell>

        <!-- CONNECTORS WITH CROW'S FOOT LABELS -->
        
        <!-- Rel 1: User (Owner) -> Equipment (1 : N) -->
        <mxCell id="rel-user-equip" value="1 : N&#xa;(Owns Listings)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2563EB;strokeWidth=2;fontColor=#1E40AF;fontSize=11;fontStyle=1;" edge="1" parent="1" source="tbl-users" target="tbl-equipment">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Rel 2: Category -> Equipment (1 : N) -->
        <mxCell id="rel-cat-equip" value="1 : N&#xa;(Classifies)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2563EB;strokeWidth=2;fontColor=#1E40AF;fontSize=11;fontStyle=1;" edge="1" parent="1" source="tbl-categories" target="tbl-equipment">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Rel 3: Equipment -> Bookings (1 : N) -->
        <mxCell id="rel-equip-booking" value="1 : N&#xa;(Reserved In)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2563EB;strokeWidth=2;fontColor=#1E40AF;fontSize=11;fontStyle=1;" edge="1" parent="1" source="tbl-equipment" target="tbl-bookings">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Rel 4: User (Farmer) -> Bookings (1 : N) -->
        <mxCell id="rel-farmer-booking" value="1 : N (Creates Bookings)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2563EB;strokeWidth=2;fontColor=#1E40AF;fontSize=11;fontStyle=1;" edge="1" parent="1" source="tbl-users" target="tbl-bookings">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="220" y="480" />
              <mxPoint x="1370" y="480" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Rel 5: Booking -> Payment (1 : 1) -->
        <mxCell id="rel-booking-payment" value="1 : 1&#xa;(Settles)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#16A34A;strokeWidth=2;fontColor=#15803D;fontSize=11;fontStyle=1;" edge="1" parent="1" source="tbl-bookings" target="tbl-payments">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Rel 6: User -> Notifications (1 : N) -->
        <mxCell id="rel-user-notif" value="1 : N&#xa;(Receives)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2563EB;strokeWidth=2;fontColor=#1E40AF;fontSize=11;fontStyle=1;" edge="1" parent="1" source="tbl-users" target="tbl-notifications">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Rel 7: Equipment -> Reviews (1 : N) -->
        <mxCell id="rel-equip-review" value="1 : N&#xa;(Reviewed In)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2563EB;strokeWidth=2;fontColor=#1E40AF;fontSize=11;fontStyle=1;" edge="1" parent="1" source="tbl-equipment" target="tbl-reviews">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Rel 8: User (Farmer) -> Reviews (1 : N) -->
        <mxCell id="rel-farmer-review" value="1 : N (Writes Reviews)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2563EB;strokeWidth=2;fontColor=#1E40AF;fontSize=11;fontStyle=1;" edge="1" parent="1" source="tbl-users" target="tbl-reviews">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="380" y="520" />
              <mxPoint x="750" y="520" />
              <mxPoint x="750" y="645" />
            </Array>
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
