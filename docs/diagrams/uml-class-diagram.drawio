        </mxCell>

        <!-- Legend Box -->
        <mxCell id="legend-box" value="UML 2.5 NOTATION LEGEND:  + Public Attribute/Method  |  - Private Attribute  |  # Protected  |  --&gt; Association  |  ..&gt; Dependency  |  Header: Blue = Models, Green = Controllers, Orange = Middleware" style="rounded=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1;fontSize=11;fontColor=#334155;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="130" width="1920" height="40" as="geometry" />
        </mxCell>

        <!-- ================= MODELS COMPARTMENT ================= -->
        
        <!-- User Model -->
